{
  "name": "openjournal",
  "version": "1.0.0",
  "description": "Fork moderno e responsivo do RedNotebook preservando 100% de compatibilidade com o formato de histórico YAML.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "downloads": "concurrently \"npm run server\" \"wait-on http://localhost:3001 && start http://localhost:3001/downloads\"",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "preview": "vite preview client",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"npm run client\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "dist": "npm run electron:build",
    "publish": "node scripts/publish-release.js",
    "icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "rednotebook",
    "journal",
    "diario",
    "openjournal",
    "yaml",
    "markdown"
  ],
  "author": "Antigravity",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  }
}
