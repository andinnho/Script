{
  "name": "openjournal",
  "version": "1.0.0",
  "description": "Fork moderno e responsivo do RedNotebook preservando 100% de compatibilidade com o formato de histórico YAML.",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "preview": "vite preview client"
  },
  "keywords": [
    "rednotebook",
    "journal",
    "diario",
    "openjournal",
    "yaml",
    "markdown"
  ],
  "author": "Antigravity",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  }
}
